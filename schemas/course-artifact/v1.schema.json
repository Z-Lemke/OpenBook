{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbook.local/schemas/course-artifact/v1.schema.json",
  "title": "OpenBook Course Artifact v1",
  "description": "The immutable, declarative course revision exchanged between OpenBook's course agent, renderer, persistence, and test harness.",
  "$comment": "JSON Schema enforces local shape. Cross-record lineage rules—unique IDs, contiguous lesson ordering, page/lesson references, source references, and command references—are enforced by openbook.course_artifact.validate_course_artifact and validate_fixture_bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "revision",
    "predecessorArtifactId",
    "learner",
    "title",
    "lessons",
    "coursePage",
    "readAheadPage",
    "dailyPage",
    "sourceCandidates",
    "sourceUses",
    "sourceGaps"
  ],
  "properties": {
    "schemaVersion": { "const": "course-artifact/v1" },
    "artifactId": { "$ref": "#/$defs/nonBlankString" },
    "revision": { "type": "integer", "minimum": 1 },
    "predecessorArtifactId": { "type": ["string", "null"], "pattern": "\\S" },
    "learner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "availableMinutesPerDay"],
      "properties": {
        "goal": { "$ref": "#/$defs/nonBlankString" },
        "availableMinutesPerDay": { "type": "integer", "minimum": 1 }
      }
    },
    "title": { "$ref": "#/$defs/nonBlankString" },
    "lessons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lesson" } },
    "coursePage": { "$ref": "#/$defs/coursePage" },
    "readAheadPage": { "$ref": "#/$defs/readAheadPage" },
    "dailyPage": { "$ref": "#/$defs/dailyPage" },
    "sourceCandidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceCandidate" } },
    "sourceUses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceUse" } },
    "sourceGaps": { "type": "array", "items": { "$ref": "#/$defs/sourceGap" } }
  },
  "allOf": [
    {
      "if": { "properties": { "revision": { "const": 1 } } },
      "then": { "properties": { "predecessorArtifactId": { "type": "null" } } },
      "else": { "properties": { "predecessorArtifactId": { "$ref": "#/$defs/nonBlankString" } } }
    }
  ],
  "$defs": {
    "nonBlankString": { "type": "string", "pattern": "\\S" },
    "htmlPageSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageId", "kind", "title", "blocks"],
      "properties": {
        "pageId": { "$ref": "#/$defs/nonBlankString" },
        "kind": { "enum": ["course", "read-ahead", "daily", "lesson"] },
        "title": { "$ref": "#/$defs/nonBlankString" },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/htmlBlock" } }
      }
    },
    "coursePage": {
      "allOf": [
        { "$ref": "#/$defs/htmlPageSpec" },
        { "properties": { "kind": { "const": "course" } } }
      ]
    },
    "readAheadPage": {
      "allOf": [
        { "$ref": "#/$defs/htmlPageSpec" },
        { "properties": { "kind": { "const": "read-ahead" } } }
      ]
    },
    "dailyPage": {
      "allOf": [
        { "$ref": "#/$defs/htmlPageSpec" },
        { "properties": { "kind": { "const": "daily" } } }
      ]
    },
    "htmlBlock": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["blockId", "type", "text"], "properties": { "blockId": { "$ref": "#/$defs/nonBlankString" }, "type": { "enum": ["text", "prompt"] }, "text": { "$ref": "#/$defs/nonBlankString" } } },
        { "type": "object", "additionalProperties": false, "required": ["blockId", "type", "lessonId", "text"], "properties": { "blockId": { "$ref": "#/$defs/nonBlankString" }, "type": { "const": "lesson-link" }, "lessonId": { "$ref": "#/$defs/nonBlankString" }, "text": { "$ref": "#/$defs/nonBlankString" } } }
      ]
    },
    "lesson": { "type": "object", "additionalProperties": false, "required": ["lessonId", "order", "title", "page"], "properties": { "lessonId": { "$ref": "#/$defs/nonBlankString" }, "order": { "type": "integer", "minimum": 1 }, "title": { "$ref": "#/$defs/nonBlankString" }, "page": { "allOf": [ { "$ref": "#/$defs/htmlPageSpec" }, { "properties": { "kind": { "const": "lesson" } } } ] } } },
    "sourceCandidate": { "type": "object", "additionalProperties": false, "required": ["sourceId", "title", "url", "coverage", "provenance", "permittedUse", "retrievalContext"], "properties": { "sourceId": { "$ref": "#/$defs/nonBlankString" }, "title": { "$ref": "#/$defs/nonBlankString" }, "url": { "$ref": "#/$defs/nonBlankString" }, "coverage": { "$ref": "#/$defs/nonBlankString" }, "provenance": { "$ref": "#/$defs/nonBlankString" }, "permittedUse": { "$ref": "#/$defs/nonBlankString" }, "retrievalContext": { "$ref": "#/$defs/nonBlankString" } } },
    "sourceUse": { "type": "object", "additionalProperties": false, "required": ["useId", "sourceId", "lessonId", "role", "coveredClaim"], "properties": { "useId": { "$ref": "#/$defs/nonBlankString" }, "sourceId": { "$ref": "#/$defs/nonBlankString" }, "lessonId": { "$ref": "#/$defs/nonBlankString" }, "role": { "$ref": "#/$defs/nonBlankString" }, "coveredClaim": { "$ref": "#/$defs/nonBlankString" } } },
    "sourceGap": { "type": "object", "additionalProperties": false, "required": ["gapId", "lessonId", "need"], "properties": { "gapId": { "$ref": "#/$defs/nonBlankString" }, "lessonId": { "$ref": "#/$defs/nonBlankString" }, "need": { "$ref": "#/$defs/nonBlankString" } } }
  }
}
